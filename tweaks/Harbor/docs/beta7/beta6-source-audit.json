      "67: }",
      "68: static NSString *HBFindModule(UIViewController *controller, HBSystemDestination destination, NSUInteger depth) {",
      "69:     if (depth > 4) return nil;",
      "70:     id identifier = HBGetObject(controller, @\"moduleIdentifier\");",
      "71:     if ([identifier isKindOfClass:NSString.class]) {",
      "72:         NSString *name = [identifier lowercaseString];",
      "73:         if (destination == HBSystemDestinationConnections && [name containsString:@\"connectivity\"]) return identifier;",
      "74:         if (destination == HBSystemDestinationFocus && ([name containsString:@\"donotdisturb\"] || [name containsString:@\"focus\"])) return identifier;",
      "75:         if (destination == HBSystemDestinationVolume && ([name containsString:@\"volume\"] ||",
      "76:             [name isEqual:@\"com.apple.mediaremote.controlcenter.audio\"])) return identifier;",
      "77:         if (destination == HBSystemDestinationBrightness && ([name containsString:@\"displaymodule\"] ||",
      "78:             ([name containsString:@\"brightness\"] && ![name containsString:@\"keyboard\"]))) return identifier;"
