      "441: - (void)setDashboardActive:(BOOL)active {",
      "442:     if (self.previewMode || self.active == active) return; self.active = active;",
      "443:     if (active) {",
      "444:         [self loadViewIfNeeded]; [self reloadSelectedProfile:YES]; [self applyAppearance]; [self refreshStatus]; [self.media start];",
